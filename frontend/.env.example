# Neev Platform - Firebase Authentication Configuration
# Copy this file to .env and insert your Firebase project's web app credentials.
# Only public client keys belong here. NEVER place Firebase Admin secrets in frontend code.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_API_BASE_URL=http://localhost:5000
