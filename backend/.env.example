# Neev Platform — Express Backend Configuration
# Copy this file to .env and configure your local development environment.
# NEVER commit .env, private keys, or service account credential files to version control.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Explicit Mock Control (Strict: Set to false in production)
ALLOW_MOCK_EMBEDDINGS=false
ALLOW_MOCK_AI=false

# Firebase Admin Configuration (Authentication & Cloud Storage)
# Option A: Path to service account JSON key file (recommended for local dev)
# e.g., GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=neev-f681e
FIREBASE_STORAGE_BUCKET=neev-f681e.firebasestorage.app

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# Cloud Object Storage Configuration (Phase 5)
# ------------------------------------------------------------------------------
# Provider options:
#   'firebase' : Firebase Cloud Storage (5 GB Free Tier - uses existing Firebase project)
#   'filebase' : Filebase S3-Compatible Storage (5 GB Free Tier, Free Egress - https://filebase.com)
#   'r2'       : Cloudflare R2 (10 GB Free Tier, Free Egress)
#   'local'    : Local disk storage (development default)
STORAGE_PROVIDER=firebase
STORAGE_LOCAL_DIR=./uploads/answer-sheets
STORAGE_MAX_FILE_SIZE_MB=15

# Filebase S3-Compatible Credentials (5 GB Free Tier, Free Egress, 1 Bucket)
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
FILEBASE_BUCKET_NAME=

# Cloudflare R2 Credentials (Optional alternative)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neev-syllabus-prod
R2_REGION=auto

# OCR Configuration
# Uses pdf-parse for text-based PDFs and tesseract.js for scanned images (JPG, PNG)
OCR_LANGUAGE=eng

# ------------------------------------------------------------------------------
# Phase 4 & 5: Syllabus-Based AI Evaluation & Cloud RAG Configuration
# ------------------------------------------------------------------------------

# Grok / xAI Configuration
# API key from https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_TIMEOUT_MS=30000

# Cloud Embedding Provider Configuration for Persistent Syllabus Vector Index
# Providers:
#   'gemini'  : Google Gemini text-embedding-004 (768d, recommended free tier)
#   'openai'  : OpenAI text-embedding-3-small (1536d)
#   'mock'    : Offline deterministic mock (strictly for test suites)
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=20000

# MongoDB Atlas Vector Search Configuration
# Index definition name configured in MongoDB Atlas Search UI
ATLAS_VECTOR_INDEX_NAME=syllabus_vector_index

# RAG Retrieval & Ingestion Parameters
RAG_TOP_K=4
RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=120
SYLLABUS_COLLECTION_DIR=./data/syllabus
SYLLABUS_MAX_FILE_SIZE_MB=50
