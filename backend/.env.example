# Neev Platform — Express Backend Configuration
# Copy this file to .env and configure your local development environment.
# NEVER commit .env, private keys, or service account credential files to version control.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin Configuration
# Option A: Path to service account JSON key file (recommended for local dev)
# e.g., GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Project ID (required for Application Default Credentials or ID validation)
FIREBASE_PROJECT_ID=

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Storage Provider Configuration (Phase 3)
# Provider options: 'local' (default for development), 's3', 'gcs', 'firebase'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/answer-sheets
STORAGE_MAX_FILE_SIZE_MB=15

# OCR Configuration (Phase 3)
# Uses pdf-parse for text-based PDFs and tesseract.js for scanned images (JPG, PNG)
OCR_LANGUAGE=eng
