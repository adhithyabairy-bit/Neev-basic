# Neev Platform — Express Backend Configuration
# Copy this file to .env and configure your local development environment.
# NEVER commit .env, private keys, or service account credential files to version control.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin Configuration
# Option A: Path to service account JSON key file (recommended for local dev)
# e.g., GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Project ID (required for Application Default Credentials or ID validation)
FIREBASE_PROJECT_ID=

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Storage Provider Configuration (Phase 3)
# Provider options: 'local' (default for development), 's3', 'gcs', 'firebase'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/answer-sheets
STORAGE_MAX_FILE_SIZE_MB=15

# OCR Configuration (Phase 3)
# Uses pdf-parse for text-based PDFs and tesseract.js for scanned images (JPG, PNG)
OCR_LANGUAGE=eng

# ------------------------------------------------------------------------------
# Phase 4: Syllabus-Based AI Evaluation & RAG Configuration
# ------------------------------------------------------------------------------

# Grok / xAI Configuration
# API key from https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_TIMEOUT_MS=25000

# Embedding Provider Configuration for Persistent Syllabus Vector Index
# Providers: 'openai' (uses text-embedding-3-small), 'voyage', 'local', 'mock' (default offline test mode)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# MongoDB Atlas Vector Search Configuration
# Index definition name configured in MongoDB Atlas Search UI
ATLAS_VECTOR_INDEX_NAME=syllabus_vector_index

# RAG Retrieval & Ingestion Parameters
RAG_TOP_K=4
RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=120
SYLLABUS_COLLECTION_DIR=./syllabus
SYLLABUS_MAX_FILE_SIZE_MB=50
