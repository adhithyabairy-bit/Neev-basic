{
  "name": "neev-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Neev — Express Authentication Backend with Firebase Admin SDK",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/**/*.test.js",
    "test:storage": "node src/scripts/testStorageConnection.js",
    "worker:ingest": "node src/workers/ingestionWorker.js",
    "ingest:syllabus": "node src/scripts/ingestSyllabusDirectory.js",
    "upload:syllabus": "node src/scripts/uploadLargeSyllabusPdf.js",
    "upload:zip": "node src/scripts/ingestCurriculumZip.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "tesseract.js": "^7.0.0"
  }
}
